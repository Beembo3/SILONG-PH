# Copy this file to .env and replace every placeholder before running the app.
# Never commit a real .env file.

# --- Database (Supabase Postgres) -------------------------------------------
# Supabase Dashboard -> Connect -> Connection string (URI).
# DATABASE_URL is the transaction pooler (port 6543) used by the app.
# DIRECT_URL is the session pooler/direct connection (port 5432) used by migrations.
# A Supabase API key is NOT needed by this app; Prisma connects over Postgres.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Cache / distributed rate limiting (optional) ---------------------------
# When set, weather snapshots and rate-limit counters are shared through Redis.
# Leave blank to use the in-process fallback (single instance only).
REDIS_URL="redis://127.0.0.1:6379"

# --- Authentication ---------------------------------------------------------
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Used only by `npm run db:seed` to create the first administrator.
# Use a unique password of at least 12 characters. Remove after seeding.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Application ------------------------------------------------------------
# Public origin used for metadata, origin checks, and cookies. Use the final
# https:// origin in production. http://localhost:3000 is only for local
# production smoke tests; session cookies are non-Secure over HTTP.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional port for `next start` (default 3000).
# PORT="3000"

# Bearer token for POST /api/cron/weather (scheduled cache warming).
CRON_SECRET=""

# --- Optional hardening -----------------------------------------------------
# Separate salt for hashed client IPs in rate-limit keys. Falls back to
# AUTH_SECRET when omitted.
# RATE_LIMIT_SALT=""
