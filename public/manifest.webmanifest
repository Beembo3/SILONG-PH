{
  "name": "SILONG PH — Kaligtasan sa Init sa Central Luzon",
  "short_name": "SILONG PH",
  "description": "Alamin ang estimated heat index, opisyal na babala, preskong lugar, at mga dapat gawin para manatiling ligtas sa init.",
  "id": "/",
  "start_url": "/",
